{
  "app": {
    "name": "quant_kor",
    "env": "dev",
    "timezone": "Asia/Seoul"
  },
  "paths": {
    "project_root": ".",
    "db_sqlite": "db/sqlite/quant.db",
    "logs": {
      "app": "logs/app",
      "error": "logs/error",
      "audit": "logs/audit",
      "raw_api": {
        "krx": "logs/raw_api_response/krx",
        "dart": "logs/raw_api_response/dart",
        "kis": "logs/raw_api_response/kis"
      }
    }
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s | %(levelname)s | %(name)s | %(message)s"
  },
  "database": {
    "db_path": "db/sqlite/quant.db",
    "timeout": 30
  }
}
